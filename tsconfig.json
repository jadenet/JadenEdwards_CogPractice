{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./bankapp-node-api-backend",
    "outDir": "./bankapp-node-api-backend/dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["bankapp-node-api-backend/server.ts", "bankapp-node-api-backend/src/**/*.ts", "bankapp-node-api-backend/src/routes/a"],
  "exclude": ["bankapp-node-api-backend/node_modules", "bankapp-node-api-backend/dist"]
}