{
  "info": {
    "name": "NodeRESTApiBackend",
    "description": "MongoDB-backed banking API. Register or log in first to populate token and userId. Admin-only requests require the seeded admin account or another admin token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"email\": \"register-{{$timestamp}}@example.com\",\n  \"username\": \"user_{{$timestamp}}\",\n  \"password\": \"Banking123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const response = pm.response.json();",
                "if (response.token) pm.collectionVariables.set('token', response.token);",
                "if (response.user && response.user.user_id) pm.collectionVariables.set('userId', response.user.user_id);"
              ]
            }
          }]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const response = pm.response.json();",
                "if (response.token) pm.collectionVariables.set('token', response.token);",
                "if (response.user && response.user.user_id) pm.collectionVariables.set('userId', response.user.user_id);"
              ]
            }
          }]
        },
        {
          "name": "Get signed-in user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (admin)",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users" }
        },
        {
          "name": "Create a user (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Ray\",\n  \"email\": \"alex-{{$timestamp}}@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get a user",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users/{{userId}}" }
        },
        {
          "name": "Update a user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Ray Updated\",\n  \"email\": \"alex-updated@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Delete a user (admin)",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/users/{{userId}}" }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "List all accounts (admin)",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts" }
        },
        {
          "name": "List accounts for a user",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts/user/{{userId}}" }
        },
        {
          "name": "Create an account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"accountType\": \"CHECKING\",\n  \"balance\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/accounts"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const response = pm.response.json();",
                "if (response.accountId) pm.collectionVariables.set('accountId', response.accountId);"
              ]
            }
          }]
        },
        {
          "name": "Get an account",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts/{{accountId}}" }
        },
        {
          "name": "Update an account",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"SAVINGS\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/accounts/{{accountId}}"
          }
        },
        {
          "name": "Delete an account (admin)",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/accounts/{{accountId}}" }
        },
        {
          "name": "Deposit money",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposit"
          }
        },
        {
          "name": "Withdraw money",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw"
          }
        },
        {
          "name": "List account transactions",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts/{{accountId}}/transactions" }
        }
      ]
    },
    {
      "name": "Transactions (admin)",
      "item": [
        {
          "name": "List all transactions",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/transactions" }
        },
        {
          "name": "Create a transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"type\": \"DEPOSIT\",\n  \"amount\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/transactions"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const response = pm.response.json();",
                "if (response.transactionId) pm.collectionVariables.set('transactionId', response.transactionId);"
              ]
            }
          }]
        },
        {
          "name": "Update a transaction",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 30\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
          }
        },
        {
          "name": "Delete a transaction",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/transactions/{{transactionId}}" }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "admin" }
  ]
}
